rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /leaves/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['text','name','createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
